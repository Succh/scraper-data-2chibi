# 二次元趣闻采集器 - 环境变量配置

# ── ModelScope（魔搭）AI ─────────────────────
# 魔搭 API Key（每天 100 次免费调用）
# 获取: https://modelscope.cn/docs/model-service/API-Inference/API-intro
MODELSCOPE_API_KEY=your_modelscope_api_key_here

# ── Notion ──────────────────────────────────
# Notion Integration Token
# 获取: https://www.notion.so/my-integrations
NOTION_TOKEN=your_notion_token_here
# Notion 数据库 ID（从数据库 URL 中提取）
NOTION_DATABASE_ID=your_database_id_here

# ── Supabase（可选） ────────────────────────
# Supabase 项目 URL
# 格式: https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co
# Supabase API Key（推荐用 service_role key，支持 upsert）
# 获取: Project Settings → API → service_role key
SUPABASE_KEY=your_supabase_service_role_key_here
